# Environment variables for the FastAPI server.
# Copy to .env locally; never commit values or secrets.
# ALLOWED_ORIGINS: comma-separated frontend origins for CORS; FRONTEND_ORIGIN is the single-origin fallback.
ALLOWED_ORIGINS=
FRONTEND_ORIGIN=
# Identity validation calls Supabase Auth with the public key; the service role key is reserved for server-only data access.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UNIPROT_REQUESTS_PER_MINUTE: queries one signed-in caller may forward to UniProt each minute, per process (default 20; 0 disables it).
UNIPROT_REQUESTS_PER_MINUTE=
# GROQ_API_KEY: server-side key for the interpretation assistant; without it the route answers 503.
GROQ_API_KEY=
# ASSISTANT_MODEL: Groq model id (default openai/gpt-oss-120b, a reasoning model).
ASSISTANT_MODEL=
# ASSISTANT_REQUESTS_PER_MINUTE: interpretations one signed-in caller may request each minute, per process (default 6; 0 disables it).
ASSISTANT_REQUESTS_PER_MINUTE=
