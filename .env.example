# Environment variables for the FastAPI server.
# Copy to .env locally; never commit values or secrets.
# ALLOWED_ORIGINS: comma-separated frontend origins for CORS; FRONTEND_ORIGIN is the single-origin fallback.
ALLOWED_ORIGINS=
FRONTEND_ORIGIN=
# Identity validation and every data request use the public key plus the caller's JWT, so RLS decides access.
# The API never reads a service role key; do not define one in this environment.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# UNIPROT_REQUESTS_PER_MINUTE: queries one signed-in caller may forward to UniProt each minute, per process (default 20; 0 disables it).
UNIPROT_REQUESTS_PER_MINUTE=
# GROQ_API_KEY: server-side key for the interpretation assistant; without it the route answers 503.
GROQ_API_KEY=
# ASSISTANT_MODEL: Groq model id (default openai/gpt-oss-120b, a reasoning model).
ASSISTANT_MODEL=
# ASSISTANT_REQUESTS_PER_MINUTE: interpretations one signed-in caller may request each minute, per process (default 6; 0 disables it).
ASSISTANT_REQUESTS_PER_MINUTE=
# ASSISTANT_CACHE_TTL_SECONDS / ASSISTANT_CACHE_MAX_ENTRIES: verified readings kept in memory per process, per caller and prompt version (defaults 300 s and 256; 0 disables).
ASSISTANT_CACHE_TTL_SECONDS=
ASSISTANT_CACHE_MAX_ENTRIES=
# FOLDING_ENABLED: explicit opt-in to the shared ESM Atlas service (disabled unless exactly enabled).
# Per process: one request at a time, 3 per minute overall, 1 per minute per caller. No automatic retries.
FOLDING_ENABLED=
# API_DOCS_ENABLED: serves /docs, /redoc and /openapi.json only when exactly enabled; leave it empty in production.
API_DOCS_ENABLED=
# LIVE_ENABLED: serves the WebSocket channel /v1/live only when exactly enabled. It accepts handshakes from
# ALLOWED_ORIGINS alone and each connection reads the caller's projects every LIVE_POLL_SECONDS (default 5).
# LIVE_MAX_CONNECTION_SECONDS (default 240) must stay below the platform's function duration (300 s on Vercel Hobby).
LIVE_ENABLED=
# SHARED_REQUESTS_PER_MINUTE: reads of shared links one visitor address may make each minute, per process (default 30; 0 disables it).
SHARED_REQUESTS_PER_MINUTE=
LIVE_POLL_SECONDS=
LIVE_MAX_CONNECTION_SECONDS=
